datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         String          @default("STUDENT") // "STUDENT" | "ADMIN"
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      StudentProfile?
  applications Application[]
}

model StudentProfile {
  id         String         @id @default(uuid())
  userId     String         @unique
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  phone      String?
  bio        String?
  avatarUrl  String?
  resumeUrl  String?
  location   String?
  targetRole String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  educations Education[]
  skills     StudentSkill[]
}

model Education {
  id           String         @id @default(uuid())
  profileId    String
  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean        @default(false)
  gpa          Float?
}

model Skill {
  id               String            @id @default(uuid())
  name             String            @unique
  category         String
  studentSkills    StudentSkill[]
  internshipSkills InternshipSkill[]
}

model StudentSkill {
  id        String         @id @default(uuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     String         @default("INTERMEDIATE") // "BEGINNER" | "INTERMEDIATE" | "ADVANCED" | "EXPERT"

  @@unique([profileId, skillId])
}

model Category {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  internships Internship[]
}

model Internship {
  id               String            @id @default(uuid())
  title            String
  companyName      String
  companyLogo      String?
  location         String
  workMode         String            @default("REMOTE") // "REMOTE" | "HYBRID" | "ONSITE"
  type             String            @default("INTERNSHIP") // "FULL_TIME" | "PART_TIME" | "INTERNSHIP"
  description      String
  responsibilities String?
  requirements     String?
  stipend          Float?
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  status           String            @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "CLOSED"
  deadline         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  requiredSkills   InternshipSkill[]
  applications     Application[]
}

model InternshipSkill {
  id           String     @id @default(uuid())
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  isRequired   Boolean    @default(true)

  @@unique([internshipId, skillId])
}

model Application {
  id           String   @id @default(uuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  status       String   @default("APPLIED") // "APPLIED" | "UNDER_REVIEW" | "INTERVIEWING" | "OFFERED" | "REJECTED" | "WITHDRAWN"
  coverLetter  String?
  matchScore   Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, internshipId])
}

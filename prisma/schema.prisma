datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  email        String          @unique
  passwordHash String
  role         String          @default("STUDENT") // "STUDENT" | "ADMIN"
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      StudentProfile?
  applications Application[]
}

model StudentProfile {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  userId            String         @unique @db.ObjectId
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  phone             String?
  bio               String?
  avatarUrl         String?
  resumeUrl         String?
  location          String?
  targetRole        String?
  preferredWorkMode String?        @default("REMOTE") // "REMOTE" | "HYBRID" | "ONSITE"
  preferredCategory String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  educations        Education[]
  skills            StudentSkill[]
}

model Education {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  profileId    String         @db.ObjectId
  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean        @default(false)
  gpa          Float?
}

model Skill {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String            @unique
  category         String
  studentSkills    StudentSkill[]
  internshipSkills InternshipSkill[]
}

model StudentSkill {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  profileId String         @db.ObjectId
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String         @db.ObjectId
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     String         @default("INTERMEDIATE") // "BEGINNER" | "INTERMEDIATE" | "ADVANCED" | "EXPERT"

  @@unique([profileId, skillId])
}

model Category {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  slug        String       @unique
  internships Internship[]
}

model Internship {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  companyName      String
  companyLogo      String?
  location         String
  workMode         String            @default("REMOTE") // "REMOTE" | "HYBRID" | "ONSITE"
  type             String            @default("INTERNSHIP") // "FULL_TIME" | "PART_TIME" | "INTERNSHIP"
  description      String
  responsibilities String?
  requirements     String?
  stipend          Float?
  categoryId       String            @db.ObjectId
  category         Category          @relation(fields: [categoryId], references: [id])
  status           String            @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "CLOSED"
  deadline         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  requiredSkills   InternshipSkill[]
  applications     Application[]
}

model InternshipSkill {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  internshipId String     @db.ObjectId
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skillId      String     @db.ObjectId
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  isRequired   Boolean    @default(true)

  @@unique([internshipId, skillId])
}

model Application {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String     @db.ObjectId
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipId String     @db.ObjectId
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  status       String     @default("APPLIED") // "APPLIED" | "UNDER_REVIEW" | "INTERVIEWING" | "OFFERED" | "REJECTED" | "WITHDRAWN"
  coverLetter  String?
  matchScore   Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, internshipId])
}
